{
    "name": "hulang/think-jwt",
    "description": "基于 firebase/php-jwt ^7.2 的 ThinkPHP 8.0+ JWT 验证,内置路由中间件",
    "keywords": [
        "auth",
        "authentication",
        "php-jwt",
        "jwt",
        "thinkphp",
        "middleware"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "hulang",
            "email": "hulangfy@163.com"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "topthink/framework": "^8.0.0",
        "firebase/php-jwt": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "think\\": "src/"
        }
    },
    "extra": {
        "think": {
            "config": {
                "jwt": "config/config.php"
            }
        }
    }
}
